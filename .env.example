# ---- AI video (fal.ai) ----
FAL_KEY=

# ---- Accounts and credits (Supabase, project studio-hq) ----
NEXT_PUBLIC_SUPABASE_URL=https://nevvtwaackapjpyvtnha.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dashboard → Project Settings → API keys → secret / service_role. Server only, never public.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments (Grow / Meshulam). Grow support gives you these. ----
GROW_ENV=sandbox            # sandbox | production
GROW_USER_ID=
GROW_API_KEY=
GROW_PAGE_CODE_RECURRING=   # page code of the recurring (הוראת קבע) payment page
GROW_PAGE_CODE_ONETIME=     # page code of the regular credit-card page
GROW_NOTIFY_SECRET=         # any long random string; protects /api/billing/notify
GROW_WEBHOOK_KEY=           # the webhookKey Grow sends with recurring-charge webhooks
GROW_RECURRING_CHARGES=     # only if Grow asks for a number of monthly charges (2–48)

# Optional: the public address, if different from the request host
NEXT_PUBLIC_SITE_URL=

# Only when accounts are NOT configured: a shared password for generation
APP_PASSWORD=
